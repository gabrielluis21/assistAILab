datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TECHNICIAN
  CUSTOMER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AccessGrantType {
  DEVICE_PAIRING
  USER_INVITATION
  CUSTOMER_ONBOARDING
  CUSTOMER_ACCESS
}

enum AccessGrantStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum CustomerOrganizationStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ServiceOrderStatus {
  DRAFT
  DIAGNOSTICO
  AGUARDANDO_APROVACAO
  AGUARDANDO_REAPROVACAO
  EM_EXECUCAO
  PRONTO
  ENTREGUE
  CANCELADO
}

enum OperationType {
  CREATE
  UPDATE
  DELETE
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

enum PaymentMethod {
  DINHEIRO
  CARTAO_CREDITO
  CARTAO_DEBITO
  PIX
  TRANSFERENCIA
  BOLETO
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum QuoteDecision {
  APPROVE
  REJECT
}

enum QuoteChangeType {
  INITIAL
  COMMERCIAL_CHANGE
}

enum ReceivableLifecycleStatus {
  ACTIVE
  CANCELLED
}

enum FinancialAuditOrigin {
  USER_COMMAND
  SYSTEM_DERIVED
}

enum CustomerEventType {
  SERVICE_ORDER_CREATED
  SERVICE_ORDER_COMPLETED
  SERVICE_ORDER_CANCELLED
  SERVICE_ORDER_NOT_APPROVED
  SERVICE_ORDER_RETURNED
  PAYMENT_CONFIRMED
  FEEDBACK_RECEIVED
  CUSTOMER_REGISTERED
  CUSTOMER_UPDATED
  EQUIPMENT_REGISTERED
  CAMPAIGN_SENT
  CAMPAIGN_OPENED
  CAMPAIGN_CLICKED
  CAMPAIGN_CONVERTED
  OTHER
}

enum FeedbackType {
  SERVICE
  TECHNICIAN
  PRODUCT
  GENERAL
}

enum CustomerRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum CampaignAudienceType {
  ALL_CUSTOMERS
  ACTIVE_CUSTOMERS
  INACTIVE_CUSTOMERS
  AT_RISK
  VIP
  CUSTOM
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  CONVERTED
  FAILED
  UNSUBSCRIBED
}

enum MediaEntityType {
  CUSTOMER
  EQUIPMENT
  SERVICE_ORDER
  SERVICE_ORDER_ITEM
  PART
  AI_ANALYSIS
  OTHER
}

enum MediaPurpose {
  EQUIPMENT_PHOTO
  DEFECT_PHOTO
  PART_PHOTO
  BEFORE_SERVICE
  AFTER_SERVICE
  DOCUMENT
  AI_REFERENCE
  OTHER
}

enum AIAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum EquipmentOwnerType {
  CUSTOMER
  ORGANIZATION
}

enum EquipmentPurpose {
  RESALE
  PARTS_DONOR
  INTERNAL_USE
}

enum EquipmentAcquisitionStatus {
  PENDING
  AUTHORIZED
  REJECTED
  CANCELLED
  COMPLETED
}

enum EquipmentConsentMethod {
  CUSTOMER_APP
  QR_CODE
  DIGITAL_SIGNATURE
  SIGNED_DOCUMENT
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  phone        String?
  role         Role       @default(TECHNICIAN)
  status       UserStatus @default(PENDING)
  customerId   String?    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer             Customer?                   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  memberships          Membership[]
  devices              Device[]
  sessions             Session[]
  assignedOrders       ServiceOrder[]              @relation("TechnicianOrders")
  statusHistoryChanges ServiceOrderStatusHistory[] @relation("UserStatusChanges")
  createdAccessGrants  AccessGrant[]               @relation("AccessGrantCreator")
  uploadedMedia        MediaAsset[]                @relation("MediaUploadedBy")
  createdCampaigns     Campaign[]                  @relation("CampaignCreatedBy")
  paymentsCreated       Payment[]                    @relation("PaymentCreatedBy")
  paymentsConfirmed     Payment[]                    @relation("PaymentConfirmedBy")
  paymentsCancelled     Payment[]                    @relation("PaymentCancelledBy")
  quoteRevisionsCreated ServiceOrderQuoteRevision[]  @relation("QuoteRevisionCreatedBy")
  quoteDecisions        CustomerQuoteDecision[]      @relation("QuoteDecisionBy")
  receivablesCreated    Receivable[]                 @relation("ReceivableCreatedBy")
  receivablesCancelled  Receivable[]                 @relation("ReceivableCancelledBy")
  schedulesCreated      ReceivableSchedule[]         @relation("ReceivableScheduleCreatedBy")
  allocationsCreated    PaymentAllocation[]          @relation("PaymentAllocationCreatedBy")
  financialAuditEvents  FinancialAuditEvent[]        @relation("FinancialAuditActor")

  @@index([status])
  @@index([role])
  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  document  String?  @unique
  email     String?
  phone     String?
  timezone  String   @default("America/Sao_Paulo") @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships           Membership[]
  customerOrganizations CustomerOrganization[]
  devices               Device[]
  accessGrants          AccessGrant[]
  serviceOrders         ServiceOrder[]
  customerEvents        CustomerEvent[]
  campaigns             Campaign[]
  mediaAssets           MediaAsset[]
  aiAnalyses            AIAnalysis[]
  customerFeedbacks     CustomerFeedback[]
  ownedEquipments        Equipment[]
  equipmentAcquisitions  EquipmentAcquisition[]
  payments               Payment[]
  quoteRevisions         ServiceOrderQuoteRevision[]
  quoteDecisions         CustomerQuoteDecision[]
  receivables            Receivable[]
  receivableSchedules    ReceivableSchedule[]
  receivableInstallments ReceivableInstallment[]
  paymentAllocations     PaymentAllocation[]
  financialAuditEvents   FinancialAuditEvent[]

  @@index([name])
  @@map("organizations")
}

model Membership {
  id             String @id @default(uuid())
  userId         String
  organizationId String
  role           Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
  @@map("memberships")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  document  String?  @unique
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  User?
  organizations         CustomerOrganization[]
  equipments            Equipment[]
  serviceOrders         ServiceOrder[]
  payments              Payment[]
  events                CustomerEvent[]
  CustomerFeedback      CustomerFeedback[]
  MediaAsset            MediaAsset[]
  equipmentAcquisitions EquipmentAcquisition[]
  quoteRevisions         ServiceOrderQuoteRevision[]
  quoteDecisions         CustomerQuoteDecision[]
  receivables            Receivable[]
  paymentAllocations     PaymentAllocation[]

  @@index([name])
  @@index([email])
  @@index([phone])
  @@map("customers")
}

model CustomerProfile {
  id                     String @id @default(uuid())
  customerOrganizationId String @unique

  totalServiceOrders Int @default(0)
  completedOrders    Int @default(0)
  cancelledOrders    Int @default(0)
  notApprovedOrders  Int @default(0)
  returnedOrders     Int @default(0)

  totalSpent    Decimal @default(0.00) @db.Decimal(12, 2)
  averageTicket Decimal @default(0.00) @db.Decimal(12, 2)

  averageRating Decimal? @db.Decimal(3, 2)
  feedbackCount Int      @default(0)

  firstServiceAt DateTime?
  lastServiceAt  DateTime?

  riskLevel CustomerRiskLevel @default(LOW)
  riskScore Decimal?          @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerOrganization CustomerOrganization @relation(fields: [customerOrganizationId], references: [id], onDelete: Cascade)

  @@index([riskLevel])
  @@index([lastServiceAt])
  @@map("customer_profiles")
}

model CustomerOrganization {
  id             String                     @id @default(uuid())
  customerId     String
  organizationId String
  status         CustomerOrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  profile CustomerProfile?

  @@unique([customerId, organizationId])
  @@index([customerId])
  @@index([organizationId])
  @@index([status])
  @@map("customer_organizations")
}

model Equipment {
  id String @id @default(uuid())

  customerId     String?
  organizationId String?

  ownerType EquipmentOwnerType @default(CUSTOMER)

  organizationPurpose EquipmentPurpose?

  brand        String
  model        String
  serialNumber String?
  type         String
  notes        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  serviceOrders ServiceOrder[]
  mediaAssets   MediaAsset[]
  acquisitions  EquipmentAcquisition[]

  @@index([customerId])
  @@index([organizationId])
  @@index([ownerType])
  @@index([organizationPurpose])
  @@index([serialNumber])
  @@index([type])
  @@map("equipments")
}

model EquipmentAcquisition {
  id             String  @id @default(uuid())
  equipmentId    String
  customerId     String
  organizationId String
  serviceOrderId String?

  purpose EquipmentPurpose

  status EquipmentAcquisitionStatus @default(PENDING)

  offeredAmount Decimal? @db.Decimal(10, 2)

  consentMethod EquipmentConsentMethod?

  consentSnapshot Json?
  consentHash     String?

  authorizedAt DateTime?
  rejectedAt   DateTime?
  cancelledAt  DateTime?
  completedAt  DateTime?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment    Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  @@index([equipmentId])
  @@index([customerId])
  @@index([organizationId])
  @@index([serviceOrderId])
  @@index([status])
  @@index([purpose])
  @@index([organizationId, status])
  @@map("equipment_acquisitions")
}

model ServiceOrder {
  id             String  @id @default(uuid())
  friendlyId     Int     @unique @default(autoincrement())
  organizationId String
  customerId     String
  equipmentId    String
  technicianId   String?

  financeCoreVersion          Int?
  currentQuoteRevisionId      String? @unique
  lastApprovedQuoteRevisionId String? @unique

  status ServiceOrderStatus @default(DIAGNOSTICO)

  problemDescription String  @db.Text
  diagnosis          String? @db.Text
  solution           String? @db.Text

  totalAmount Decimal @default(0.00) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization          Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer              Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  equipment             Equipment                   @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  technician            User?                       @relation("TechnicianOrders", fields: [technicianId], references: [id], onDelete: SetNull)
  statusHistory         ServiceOrderStatusHistory[]
  items                 ServiceOrderItem[]
  payments              Payment[]
  customerEvents        CustomerEvent[]
  mediaAssets                MediaAsset[]
  CustomerFeedback           CustomerFeedback[]
  equipmentAcquisitions      EquipmentAcquisition[]
  quoteRevisions             ServiceOrderQuoteRevision[] @relation("ServiceOrderQuoteRevisions")
  currentQuoteRevision       ServiceOrderQuoteRevision?  @relation("CurrentQuoteRevision", fields: [currentQuoteRevisionId], references: [id], onDelete: SetNull)
  lastApprovedQuoteRevision  ServiceOrderQuoteRevision?  @relation("LastApprovedQuoteRevision", fields: [lastApprovedQuoteRevisionId], references: [id], onDelete: SetNull)
  quoteDecisions             CustomerQuoteDecision[]
  receivables                Receivable[]
  paymentAllocations         PaymentAllocation[]
  financialAuditEvents       FinancialAuditEvent[]

  @@index([organizationId])
  @@index([customerId])
  @@index([equipmentId])
  @@index([technicianId])
  @@index([status])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([financeCoreVersion])
  @@map("service_orders")
}

model ServiceOrderStatusHistory {
  id             String              @id @default(uuid())
  serviceOrderId String
  previousStatus ServiceOrderStatus?
  newStatus      ServiceOrderStatus
  changedById    String
  notes          String?             @db.Text
  createdAt      DateTime            @default(now())

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  changedBy    User         @relation("UserStatusChanges", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([serviceOrderId])
  @@index([changedById])
  @@index([createdAt])
  @@map("service_order_status_history")
}

model Part {
  id            String   @id @default(uuid())
  name          String
  sku           String   @unique
  price         Decimal  @db.Decimal(10, 2)
  costPrice     Decimal  @db.Decimal(10, 2)
  stockQuantity Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems  ServiceOrderItem[]
  mediaAssets MediaAsset[]

  @@index([name])
  @@map("parts")
}

model ServiceOrderItem {
  id             String   @id @default(uuid())
  serviceOrderId String
  partId         String?
  description    String
  quantity       Int      @default(1)
  unitPrice      Decimal  @db.Decimal(10, 2)
  totalPrice     Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  part         Part?        @relation(fields: [partId], references: [id], onDelete: SetNull)
  mediaAssets  MediaAsset[]

  @@index([serviceOrderId])
  @@index([partId])
  @@map("service_order_items")
}

model Payment {
  id                String        @id @default(uuid())
  organizationId    String
  serviceOrderId    String
  customerId        String
  clientOperationId String        @unique

  amount Decimal @db.Decimal(14, 2)

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  cardInstallmentCount Int?

  notes String? @db.Text

  paidAt      DateTime?
  cancelledAt DateTime?

  version Int @default(1)

  createdByUserId   String?
  confirmedByUserId String?
  cancelledByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)

  createdBy   User? @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  confirmedBy User? @relation("PaymentConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  cancelledBy User? @relation("PaymentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([customerId])
  @@index([serviceOrderId])
  @@index([createdByUserId])
  @@index([confirmedByUserId])
  @@index([cancelledByUserId])
  @@index([status])
  @@index([method])
  @@index([paidAt])
  @@index([cancelledAt])
  @@map("payments")
}

model ServiceOrderQuoteRevision {
  id             String @id @default(uuid())
  serviceOrderId String
  organizationId String
  customerId     String
  revisionNumber Int

  diagnosisSnapshot    String? @db.Text
  serviceItemsSnapshot Json
  partsSnapshot        Json

  totalAmount Decimal @db.Decimal(14, 2)

  changeType   QuoteChangeType
  changeReason String? @db.Text

  quoteSnapshot Json
  quoteHash     String @db.Char(64)

  createdByUserId String
  createdAt       DateTime @default(now())

  serviceOrder ServiceOrder @relation("ServiceOrderQuoteRevisions", fields: [serviceOrderId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("QuoteRevisionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  decision   CustomerQuoteDecision?
  receivable Receivable?

  currentForServiceOrder      ServiceOrder? @relation("CurrentQuoteRevision")
  lastApprovedForServiceOrder ServiceOrder? @relation("LastApprovedQuoteRevision")

  @@unique([serviceOrderId, revisionNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([serviceOrderId, createdAt])
  @@index([quoteHash])
  @@map("service_order_quote_revisions")
}

model CustomerQuoteDecision {
  id              String @id @default(uuid())
  quoteRevisionId String @unique
  serviceOrderId  String
  organizationId  String
  customerId      String

  decision QuoteDecision
  reason   String? @db.Text

  decidedByUserId String
  decidedAt       DateTime @default(now())

  quoteRevision ServiceOrderQuoteRevision @relation(fields: [quoteRevisionId], references: [id], onDelete: Restrict)
  serviceOrder  ServiceOrder              @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer      Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  decidedBy     User                      @relation("QuoteDecisionBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([serviceOrderId])
  @@index([organizationId])
  @@index([customerId])
  @@index([decidedAt])
  @@map("customer_quote_decisions")
}

model Receivable {
  id                    String @id @default(uuid())
  organizationId        String
  customerId            String
  serviceOrderId        String
  sourceQuoteRevisionId String @unique

  totalAmount Decimal @db.Decimal(14, 2)

  lifecycleStatus ReceivableLifecycleStatus @default(ACTIVE)

  currentScheduleVersion Int @default(1)
  version                Int @default(1)

  issuedAt DateTime @default(now())

  createdByUserId    String
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancellationReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization        Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer            Customer                      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceOrder        ServiceOrder                  @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceQuoteRevision ServiceOrderQuoteRevision     @relation(fields: [sourceQuoteRevisionId], references: [id], onDelete: Restrict)
  createdBy           User                          @relation("ReceivableCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cancelledBy         User?                         @relation("ReceivableCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  schedules           ReceivableSchedule[]
  installments        ReceivableInstallment[]
  allocations         PaymentAllocation[]

  @@index([organizationId])
  @@index([organizationId, lifecycleStatus])
  @@index([customerId])
  @@index([serviceOrderId])
  @@index([issuedAt])
  @@map("receivables")
}

model ReceivableSchedule {
  id             String @id @default(uuid())
  organizationId String
  receivableId   String
  version        Int

  createdByUserId String
  createdAt       DateTime @default(now())

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receivable   Receivable              @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  createdBy    User                    @relation("ReceivableScheduleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  installments ReceivableInstallment[]

  @@unique([receivableId, version])
  @@index([organizationId])
  @@index([createdAt])
  @@map("receivable_schedules")
}

model ReceivableInstallment {
  id              String @id @default(uuid())
  organizationId  String
  receivableId    String
  scheduleId      String
  scheduleVersion Int

  sequence Int
  amount   Decimal  @db.Decimal(14, 2)
  dueDate  DateTime @db.Date

  createdAt DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receivable   Receivable             @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  schedule     ReceivableSchedule     @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  allocations  PaymentAllocation[]

  @@unique([scheduleId, sequence])
  @@index([organizationId])
  @@index([receivableId])
  @@index([receivableId, scheduleVersion])
  @@index([dueDate])
  @@map("receivable_installments")
}

model PaymentAllocation {
  id             String @id @default(uuid())
  organizationId String
  customerId     String
  serviceOrderId String

  receivableId  String
  installmentId String
  paymentId     String

  amount Decimal @db.Decimal(14, 2)

  createdByUserId String
  createdAt       DateTime @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceOrder ServiceOrder          @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  receivable   Receivable            @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  installment  ReceivableInstallment @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  payment      Payment               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdBy    User                  @relation("PaymentAllocationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([customerId])
  @@index([serviceOrderId])
  @@index([receivableId])
  @@index([installmentId])
  @@index([paymentId])
  @@index([createdAt])
  @@map("payment_allocations")
}

model FinancialAuditEvent {
  id             String @id @default(uuid())
  organizationId String
  serviceOrderId String

  actorUserId String?
  origin      FinancialAuditOrigin

  eventType  String
  entityType String
  entityId   String

  operationId String
  ordinal     Int

  occurredAt DateTime @default(now())
  metadata   Json?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceOrder ServiceOrder  @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  actor        User?         @relation("FinancialAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([operationId, ordinal])
  @@index([organizationId])
  @@index([serviceOrderId])
  @@index([entityType, entityId])
  @@index([occurredAt])
  @@map("financial_audit_events")
}

model Device {
  id             String @id @default(uuid())
  userId         String
  organizationId String

  name     String
  platform String

  lastSeenAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     Session[]

  @@index([userId])
  @@index([organizationId])
  @@index([organizationId, revokedAt])
  @@map("devices")
}

model Session {
  id               String @id @default(uuid())
  userId           String
  deviceId         String
  refreshTokenHash String @unique

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model AccessGrant {
  id             String            @id @default(uuid())
  organizationId String
  type           AccessGrantType
  status         AccessGrantStatus @default(ACTIVE)

  tokenHash String @unique

  targetId    String?
  createdById String?

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("AccessGrantCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([expiresAt])
  @@index([organizationId, status])
  @@map("access_grants")
}

model SyncChangeLog {
  id            BigInt        @id @default(autoincrement())
  cursor        String        @unique
  entityType    String
  entityId      String
  operationType OperationType
  data          Json
  createdAt     DateTime      @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("sync_change_logs")
}

model OperationIdempotency {
  operationId         String            @id
  userId              String?
  organizationId      String?
  deviceId            String?
  command             String?
  endpoint            String
  requestHash         String
  status              IdempotencyStatus @default(COMPLETED)
  responseStatus      Int?
  responseBody        Json?
  processingExpiresAt DateTime?
  leaseToken          String?
  completedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([deviceId])
  @@index([command])
  @@index([endpoint])
  @@index([status, processingExpiresAt])
  @@index([createdAt])
  @@map("operation_idempotency")
}

model CustomerEvent {
  id             String @id @default(uuid())
  customerId     String
  organizationId String

  type           CustomerEventType
  serviceOrderId String?

  title       String
  description String? @db.Text
  metadata    Json?

  createdAt DateTime @default(now())

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
  @@index([customerId, createdAt])
  @@map("customer_events")
}

model CustomerFeedback {
  id             String       @id @default(uuid())
  customerId     String
  organizationId String
  serviceOrderId String?
  type           FeedbackType

  rating  Int?
  comment String? @db.Text

  createdAt DateTime @default(now())

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([organizationId])
  @@index([serviceOrderId])
  @@index([type])
  @@index([rating])
  @@map("customer_feedbacks")
}

model Campaign {
  id             String  @id @default(uuid())
  organizationId String
  createdById    String?

  name        String
  description String? @db.Text
  message     String  @db.Text

  audienceType CampaignAudienceType
  status       CampaignStatus       @default(DRAFT)

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?               @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  recipients   CampaignRecipient[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([scheduledAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String @id @default(uuid())
  campaignId String
  customerId String

  channel CampaignChannel
  status  CampaignRecipientStatus @default(PENDING)

  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  convertedAt DateTime?

  externalMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId, channel])
  @@index([campaignId])
  @@index([customerId])
  @@index([status])
  @@map("campaign_recipients")
}

model MediaAsset {
  id             String  @id @default(uuid())
  organizationId String
  uploadedById   String?

  entityType MediaEntityType
  entityId   String
  purpose    MediaPurpose

  filename   String
  mimeType   String
  sizeBytes  BigInt
  hashSha256 String
  storageKey String
  publicUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId         String?
  equipment          Equipment?        @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  equipmentId        String?
  serviceOrder       ServiceOrder?     @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  serviceOrderId     String?
  serviceOrderItem   ServiceOrderItem? @relation(fields: [serviceOrderItemId], references: [id], onDelete: SetNull)
  serviceOrderItemId String?
  part               Part?             @relation(fields: [partId], references: [id], onDelete: SetNull)
  partId             String?

  aiAnalyses AIAnalysis[]

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([purpose])
  @@index([customerId])
  @@index([equipmentId])
  @@index([serviceOrderId])
  @@index([serviceOrderItemId])
  @@index([partId])
  @@index([hashSha256])
  @@map("media_assets")
}

model AIAnalysis {
  id             String @id @default(uuid())
  organizationId String
  mediaAssetId   String

  provider String
  model    String?

  status AIAnalysisStatus @default(PENDING)

  promptVersion String?
  requestData   Json?
  responseData  Json?

  detectedType  String?
  detectedBrand String?
  detectedModel String?
  detectedPart  String?
  diagnosis     String?  @db.Text
  confidence    Decimal? @db.Decimal(5, 2)

  errorMessage String? @db.Text

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset   @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([mediaAssetId])
  @@index([status])
  @@map("ai_analyses")
}
