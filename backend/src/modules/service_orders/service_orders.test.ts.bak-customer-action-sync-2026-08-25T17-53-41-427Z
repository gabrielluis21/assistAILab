    /**
     * ========================================================
     * T051
     * ========================================================
     *
     * CUSTOMER não pode receber o objeto User completo
     * relacionado ao technician.
     *
     * Principalmente:
     *
     * passwordHash
     *
     * A representação pública permitida neste fluxo é:
     *
     * {
     *   id,
     *   name
     * }
     */
    test(
      'T051 - CUSTOMER ServiceOrder response exposes only safe technician fields',
      async () => {
        const response =
          await app.inject({
            method:
              'GET',

            url:
              `/api/v1/service-orders/${orderId}`,

            headers: {
              authorization:
                `Bearer ${customerToken}`,
            },
          });

        assert.equal(
          response.statusCode,
          200
        );

        const body =
          response.json();

        assert.ok(
          body.order
        );

        const technician =
          body
            .order
            .technician;

        assert.ok(
          technician
        );

        /**
         * Campos públicos esperados.
         */
        assert.equal(
          technician.id,
          technicianId
        );

        assert.equal(
          technician.name,
          'Client Gate Technician'
        );

        /**
         * passwordHash jamais deve estar presente.
         */
        assert.equal(
          Object.prototype
            .hasOwnProperty
            .call(
              technician,
              'passwordHash'
            ),
          false
        );

        /**
         * Garante que a projeção não voltou a ser
         * technician: true futuramente.
         */
        assert.deepEqual(
          Object.keys(
            technician
          ).sort(),
          [
            'id',
            'name',
          ]
        );
      }
    );

    /**
     * ========================================================
     * T052
     * ========================================================
     *
     * Quando uma alteração autoritativa é feita pelo REST,
     * outro dispositivo precisa conseguir descobri-la pelo
     * Background Pull.
     *
     * Portanto:
     *
     * REST ServiceOrder status update
     *          ↓
     * MySQL
     *          ↓
     * SyncChangeLog
     */
    test(
      'T052 - REST ServiceOrder status mutation publishes canonical SyncChangeLog snapshot',
      async () => {
        const response =
          await app.inject({
            method:
              'PATCH',

            url:
              `/api/v1/service-orders/${orderId}/status`,

            headers: {
              authorization:
                `Bearer ${adminToken}`,
            },

            payload: {
              newStatus:
                ServiceOrderStatus.ENTREGUE,
            },
          });

        assert.equal(
          response.statusCode,
          200
        );

        /**
         * Confirma persistência autoritativa da OS.
         */
        const updatedOrder =
          await prisma.serviceOrder.findUnique({
            where: {
              id:
                orderId,
            },
          });

        assert.ok(
          updatedOrder
        );

        assert.equal(
          updatedOrder.status,
          ServiceOrderStatus.ENTREGUE
        );

        /**
         * Confirma publicação no feed incremental.
         */
        const change =
          await prisma.syncChangeLog.findFirst({
            where: {
              entityType:
                'SERVICE_ORDER',

              entityId:
                orderId,

              operationType:
                OperationType.UPDATE,
            },

            orderBy: {
              id:
                'desc',
            },
          });

        assert.ok(
          change
        );

        /**
         * O ChangeLog deve carregar o snapshot
         * canônico suficiente para outro SQLite.
         */
        const data =
          change.data as
          Record<string, unknown>;

        assert.equal(
          data.id,
          orderId
        );

        assert.equal(
          data.status,
          ServiceOrderStatus.ENTREGUE
        );

        assert.equal(
          data.customerId,
          customerId
        );

        assert.equal(
          data.equipmentId,
          equipmentId
        );

        assert.equal(
          data.organizationId,
          organizationId
        );

        assert.equal(
          data.technicianId,
          technicianId
        );

        assert.equal(
          data.problemDescription,
          'Client app backend gate'
        );
      }
    );
  }
