              item.id ===
              order.equipmentId
          ),
          true
        );

        /**
         * Notebook atendido somente
         * por A continua oculto.
         */
        assert.equal(
          listAfter.some(
            (
              item:
                { id: string }
            ) =>
              item.id ===
              notebookJoaoId
          ),
          false
        );
      }
    );

