          firstOrderResponse.json();

        createdOrderIds.push(
          order.id
        );

        createdEquipmentIds.push(
          order.equipmentId
        );

        /**
         * ----------------------------------------------------
         * SERVICE ORDER
         * ----------------------------------------------------
