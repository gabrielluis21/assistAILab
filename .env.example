# ============================================================
# AssistAILab — Flutter Environment Example
# ============================================================
#
# Copie este arquivo para ".env" e ajuste os valores
# conforme o ambiente local.
#
# NÃO coloque secrets privados do backend neste arquivo.
# O Flutter deve possuir apenas configurações client-side.
# ============================================================

APP_ENV=development

# ------------------------------------------------------------
# Central API — Fastify / Node.js
# ------------------------------------------------------------

CENTRAL_API_SCHEME=http
CENTRAL_API_HOST=127.0.0.1
CENTRAL_API_PORT=3000
CENTRAL_API_PREFIX=/api/v1

# ------------------------------------------------------------
# Desktop Local Service
# ------------------------------------------------------------

LOCAL_SERVICE_SCHEME=http
LOCAL_SERVICE_HOST=127.0.0.1
LOCAL_SERVICE_PORT=8080

# ------------------------------------------------------------
# HTTP
# ------------------------------------------------------------

API_TIMEOUT_SECONDS=15